    if (hint) {
      if (state && state.running && curIdx >= 0) {
        hint.textContent = `▶ 執行中 ── 步驟 ${curIdx + 1} / ${seqSteps.length}`;
        hint.style.color = 'rgba(34,197,94,0.85)';
      } else if (state && !state.running && state.currentStep === -1 && state.seqId) {
        hint.textContent = '✅ 序列播放完畢';
        hint.style.color = 'rgba(0,160,233,0.85)';
      } else {
        hint.textContent = '尚未執行';
        hint.style.color = '';
      }
    }

    if (!seqSteps.length) {
      list.innerHTML = '<p class="empty">尚未設定步驟，請在下方新增</p>';
      return;
    }
    list.innerHTML = '';
    seqSteps.forEach((step, i) => {
      const item = document.createElement('div');
      item.className = 'seq-step' + (i === curIdx ? ' seq-step--active' : '');

      const typeLabel = TYPE_LABEL[step.type] || step.type;
      let preview = '';
      if (step.type === 'countdown') preview = step.countdownSecs + ' 秒倒數';
      else if (step.type === 'video') preview = '🎬 影片';
      else if (step.type === 'image') preview = '🖼 圖片';
      else preview = (step.content || '').slice(0, 24);

      const durText = step.autoDismiss > 0 ? step.autoDismiss + '秒' : '播完結束';

      item.innerHTML = `
        <span class="seq-step__num">${i + 1}</span>
        <span class="seq-step__label" title="${preview}">${preview}</span>
        <span class="seq-step__type">${typeLabel}</span>
        <span class="hint" style="font-size:10px;flex-shrink:0;">${durText}</span>
        <button class="el-btn" data-edit="${i}" title="編輯" style="color:#7dd3fc;">✏</button>
        <button class="el-btn" data-up="${i}"   title="上移">↑</button>
        <button class="el-btn" data-dn="${i}"   title="下移">↓</button>
        <button class="el-btn el-btn--del" data-rm="${i}" title="刪除">✕</button>
      `;

      item.querySelector('[data-edit]').addEventListener('click', () => enterSeqEditMode(i));

      item.querySelector('[data-up]').addEventListener('click', () => {
        if (i === 0) return;
        [seqSteps[i-1], seqSteps[i]] = [seqSteps[i], seqSteps[i-1]];
        saveSeq(); renderSeqList();
      });
      item.querySelector('[data-dn]').addEventListener('click', () => {
        if (i === seqSteps.length - 1) return;
        [seqSteps[i], seqSteps[i+1]] = [seqSteps[i+1], seqSteps[i]];
        saveSeq(); renderSeqList();
      });
      item.querySelector('[data-rm]').addEventListener('click', () => {
        const s = seqSteps[i];
        if (s.content && s.content.startsWith('__vid__') && !_mediaInPreset(s.content)) {
          const vid = s.content.slice(7);
          MediaDB.del('vid_' + vid);
          FileStore.deleteVideo(vid).catch(() => {});
          ServerStore.deleteVideo(vid).catch(() => {});
        }
        if (s.content && s.content.startsWith('__img__') && !_mediaInPreset(s.content)) {
          const imgId = s.content.slice(7);
          MediaDB.del('img_' + imgId);
          localStorage.removeItem('tapmc_img_' + imgId);
          FileStore.deleteImage(imgId).catch(() => {});
          ServerStore.deleteImage(imgId).catch(() => {});
        }
        seqSteps.splice(i, 1);
        saveSeq(); renderSeqList();
      });

      list.appendChild(item);
    });
  }

  function saveSeq() {
    localStorage.setItem('tapmc_seq', JSON.stringify({ steps: seqSteps }));
    ServerStore.saveData('tapmc_seq_steps.json', seqSteps).catch(() => {});
    FileStore.saveJSON('tapmc_seq_steps.json', seqSteps).catch(() => {});
  }

  /* ════════════════════════════════════════════════
     序列清單（Presets）管理
     儲存格式：tapmc_seq_presets = [{id, name, steps, savedAt}, ...]
     ════════════════════════════════════════════════ */
  let seqPresets = JSON.parse(localStorage.getItem('tapmc_seq_presets') || '[]');

  function savePresets() {
    try {
      localStorage.setItem('tapmc_seq_presets', JSON.stringify(seqPresets));
    } catch (e) {
      showToast('儲存失敗：瀏覽器儲存空間不足', 'warn');
      console.error('[savePresets] 寫入失敗', e);
    }
    ServerStore.saveData('tapmc_presets.json', seqPresets).catch(() => {});
    FileStore.saveJSON('tapmc_presets.json', seqPresets).catch(() => {});
  }

  function renderPresetList() {
    /* 每次都從 localStorage 重新讀取，確保顯示資料與磁碟同步 */
    seqPresets = JSON.parse(localStorage.getItem('tapmc_seq_presets') || '[]');
    const list = document.getElementById('seq-preset-list');
    if (!seqPresets.length) {
      list.innerHTML = '<p class="empty" style="font-size:11px;">尚未儲存任何序列</p>';
      return;
    }
    list.innerHTML = '';
    seqPresets.forEach((preset, i) => {
      const item = document.createElement('div');
      item.className = 'seq-preset-item';

      const d     = new Date(preset.savedAt || 0);
      const dateStr = d.getFullYear() ? `${d.getMonth()+1}/${d.getDate()} ${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}` : '';
      const countText = `${preset.steps.length} 步驟`;

      item.innerHTML = `
        <span class="seq-preset-item__name" title="${preset.name}">${preset.name}</span>
        <span class="seq-preset-item__count">${countText}</span>
        <span class="hint" style="font-size:10px;flex-shrink:0;">${dateStr}</span>
        <button class="btn btn--load" data-load="${i}">載入</button>
        <button class="el-btn el-btn--del" data-del="${i}" title="刪除">✕</button>
      `;

      /* 載入清單 → 取代目前步驟 */
      item.querySelector('[data-load]').addEventListener('click', () => {
        /* confirm() 在平板/ngrok 下會被封鎖，直接執行 */
        seqSteps = JSON.parse(JSON.stringify(preset.steps));  /* deep copy */
        saveSeq();
        renderSeqList();
        exitSeqEditMode();
        showToast(`已載入「${preset.name}」✓`);
      });

      /* 刪除清單 */
      item.querySelector('[data-del]').addEventListener('click', () => {
        /* 直接刪除，不彈 confirm */
        seqPresets.splice(i, 1);
        savePresets();
        renderPresetList();
        showToast('清單已刪除');
      });

      list.appendChild(item);
    });
  }

  /* ── 另存目前序列為新清單 ── */
  const seqSaveForm    = document.getElementById('seq-save-form');
  const seqSaveNameEl  = document.getElementById('seq-save-name');

  document.getElementById('btn-seq-save-as').addEventListener('click', () => {
    if (!seqSteps.length) { showToast('目前序列沒有步驟可儲存', 'warn'); return; }
    seqSaveForm.style.display = 'flex';
    seqSaveNameEl.value = '';
    seqSaveNameEl.focus();
  });

  document.getElementById('btn-seq-save-cancel').addEventListener('click', () => {
    seqSaveForm.style.display = 'none';
  });

  seqSaveNameEl && seqSaveNameEl.addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('btn-seq-save-confirm').click();
    if (e.key === 'Escape') document.getElementById('btn-seq-save-cancel').click();
  });

  document.getElementById('btn-seq-save-confirm').addEventListener('click', () => {
    const name = seqSaveNameEl.value.trim();
    if (!name) { showToast('請輸入清單名稱', 'warn'); seqSaveNameEl.focus(); return; }

    /* 同名則更新，否則新增 */
    const existing = seqPresets.findIndex(p => p.name === name);
    const preset   = { id: Date.now(), name, steps: JSON.parse(JSON.stringify(seqSteps)), savedAt: Date.now() };
    if (existing >= 0) {
      /* 直接覆蓋，不彈 confirm */
      seqPresets[existing] = preset;
    } else {
      seqPresets.unshift(preset);          /* 最新的放最上面 */
    }
    savePresets();
    renderPresetList();
    seqSaveForm.style.display = 'none';
    showToast(`已儲存「${name}」✓`);
  });

  /* 初始渲染 */
  renderPresetList();

  /* ── 進入編輯模式：以第 idx 步驟填充表單 ── */
  function enterSeqEditMode(idx) {
    const step = seqSteps[idx];
    if (!step) return;
    _seqEditingIdx = idx;

    /* 設定類型 */
    if (seqTypeEl) { seqTypeEl.value = step.type; onSeqTypeChange(); }

    /* 填入內容 */
    if (step.type !== 'video' && step.type !== 'image') {
      const cEl = document.getElementById('seq-content');
      if (cEl) cEl.value = step.type === 'countdown'
        ? String(step.countdownSecs || parseInt(step.content) || 60)
        : (step.content || '');
    } else {
      /* 媒體：提示保留原有，重新選取才替換 */
      const text  = document.getElementById('seq-media-text');
      const label = document.getElementById('seq-media-label');
      if (text)  text.textContent = '📎 保留原有媒體（重新選取即替換）';
      if (label) label.classList.add('img-upload-btn--loaded');
    }

    /* 大小 */
    const szEl  = document.getElementById('seq-size');
    const szVal = document.getElementById('seq-size-val');
    if (szEl)  szEl.value = step.size || 60;
    if (szVal) szVal.textContent = step.size || 60;

    /* 顏色 */
    if (step.color) {
      document.querySelectorAll('[data-seq-color]').forEach(b => {
        b.classList.toggle('color-btn--active', b.dataset.seqColor === step.color);
      });
      seqSelectedColor = step.color;
    }

    /* 位置 */
    const posEl = document.getElementById('seq-position');
    if (posEl) posEl.value = step.position || 'center';

    /* 持續秒數 */
    const durEl = document.getElementById('seq-dur');
    if (durEl) durEl.value = step.type === 'countdown'
      ? (step.countdownSecs || 0)
      : (step.autoDismiss || 0);

    /* 切換按鈕樣式 */
    const addBtn = document.getElementById('btn-seq-add');
    if (addBtn) {
      addBtn.textContent = '✅ 儲存修改';
      addBtn.style.background   = 'var(--color-orange)';
      addBtn.style.borderColor  = 'var(--color-orange)';
    }

    _showSeqCancelBtn(true);

    /* 捲動到表單 */
    const card = document.getElementById('btn-seq-add');
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  /* ── 離開編輯模式，重設表單 ── */
  function exitSeqEditMode() {
    _seqEditingIdx = -1;
    resetSeqMediaInput();

    const cEl = document.getElementById('seq-content');
    if (cEl) cEl.value = '';

    const durEl = document.getElementById('seq-dur');
    if (durEl) durEl.value = '10';

    const addBtn = document.getElementById('btn-seq-add');
    if (addBtn) {
      addBtn.textContent    = '＋ 加入序列';
      addBtn.style.background  = '';
      addBtn.style.borderColor = '';
    }

    _showSeqCancelBtn(false);
  }

  /* ── 取消按鈕動態插入/顯示切換 ── */
  function _showSeqCancelBtn(show) {
    let btn = document.getElementById('btn-seq-edit-cancel');
    if (!btn) {
      btn = document.createElement('button');
      btn.id = 'btn-seq-edit-cancel';
      btn.className = 'btn';
      btn.style.cssText = 'width:100%;margin-top:4px;display:none;';
      btn.textContent = '╳ 取消修改';
      const addBtn = document.getElementById('btn-seq-add');
      addBtn && addBtn.parentNode.insertBefore(btn, addBtn.nextSibling);
      btn.addEventListener('click', exitSeqEditMode);
    }
    btn.style.display = show ? 'block' : 'none';
  }

  /* 序列類型切換 */
  const seqTypeEl = document.getElementById('seq-type');
  function onSeqTypeChange() {
    const t = seqTypeEl ? seqTypeEl.value : 'countdown';
    const isMedia = t === 'video' || t === 'image';
    const isText  = !isMedia;
    document.getElementById('seq-text-group').style.display  = isText  ? 'block' : 'none';
    document.getElementById('seq-media-group').style.display = isMedia ? 'flex'  : 'none';
    document.getElementById('seq-color-group').style.display = isText  ? 'block' : 'none';
    const unitEl = document.getElementById('seq-size-unit');
    if (unitEl) unitEl.textContent = isMedia ? 'vw' : 'px';
    if (t === 'video') {
      document.getElementById('seq-media-file').accept = 'video/*';
      document.getElementById('seq-media-text').textContent = '🎬 選取影片檔案';
    } else if (t === 'image') {
      document.getElementById('seq-media-file').accept = 'image/*';
      document.getElementById('seq-media-text').textContent = '📂 選取圖片';
    }
  }
  seqTypeEl && seqTypeEl.addEventListener('change', onSeqTypeChange);
  onSeqTypeChange();   /* 初始狀態 */

  /* 序列媒體上傳 */
  document.getElementById('seq-media-file').addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;
    const isVideo = file.type.startsWith('video/');
    const label   = document.getElementById('seq-media-label');
    const text    = document.getElementById('seq-media-text');
    const info    = document.getElementById('seq-media-info');
    const preview = document.getElementById('seq-media-preview');

    text.textContent = '⏳ 處理中…';

    if (isVideo) {
      _seqPendingMedia = { blob: file, type: 'video', name: file.name };
      text.textContent = '✅ ' + file.name;
      label.classList.add('img-upload-btn--loaded');
      if (info)    info.textContent = `影片　${(file.size / 1024 / 1024).toFixed(1)} MB`;
      if (preview) preview.style.display = 'block';
    } else {
      compressImage(file, function (dataUrl, w, h) {
        _seqPendingMedia = { dataUrl, type: 'image', name: file.name };
        text.textContent = '✅ ' + file.name;
        label.classList.add('img-upload-btn--loaded');
        if (info)    info.textContent = `${w} × ${h}`;
        if (preview) preview.style.display = 'block';
      });
    }
  });

  /* 序列顏色選擇器 */
  document.querySelectorAll('[data-seq-color]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-seq-color]').forEach(b => b.classList.remove('color-btn--active'));
      btn.classList.add('color-btn--active');
      seqSelectedColor = btn.dataset.seqColor;
    });
  });

  /* 新增步驟 ／ 儲存修改（編輯模式共用此按鈕） */
  document.getElementById('btn-seq-add').addEventListener('click', () => {
    const type    = seqTypeEl.value;
    const size    = parseInt(document.getElementById('seq-size').value) || 60;
    const pos     = document.getElementById('seq-position').value;
    const dur     = parseInt(document.getElementById('seq-dur').value) || 0;
    const isMedia = type === 'video' || type === 'image';
    const isEdit  = _seqEditingIdx >= 0;

    /* ── 媒體（影片 / 圖片）── */
    if (isMedia) {
      /* 編輯模式且沒有新選取媒體 → 只更新 size/pos/dur */
      if (isEdit && !_seqPendingMedia) {
        const orig = seqSteps[_seqEditingIdx];
        seqSteps[_seqEditingIdx] = Object.assign({}, orig, { size, position: pos, autoDismiss: dur });
        saveSeq(); renderSeqList(); exitSeqEditMode();
        showToast('步驟已修改 ✓');
        return;
      }
      if (!_seqPendingMedia) { showToast('請先選取媒體檔案', 'warn'); return; }

      const id = Date.now();
      if (_seqPendingMedia.type === 'video') {
        /* 若替換舊影片，只在沒有 preset 引用時才刪舊資料 */
        if (isEdit) {
          const old = seqSteps[_seqEditingIdx];
          if (old && old.content && old.content.startsWith('__vid__') && !_mediaInPreset(old.content)) {
            const ov = old.content.slice(7);
            MediaDB.del('vid_' + ov);
            FileStore.deleteVideo(ov).catch(() => {});
            ServerStore.deleteVideo(ov).catch(() => {});
          }
        }
        const seqVidBlob = _seqPendingMedia.blob;
        const seqVidName = document.getElementById('seq-media-file')?.files[0]?.name || 'video.mp4';
        /* 1. 伺服器（跨電腦） */
        ServerStore.saveVideo(id, seqVidBlob, seqVidName).catch(() => {});
        /* 2. 磁碟（FileStore） */
        FileStore.saveVideo(id, seqVidBlob, seqVidName).catch(() => {});
        /* 3. IndexedDB（本機備援） */
        MediaDB.put('vid_' + id, seqVidBlob).then(() => {
          const step = { type: 'video', content: '__vid__' + id,
                         size, position: pos, autoDismiss: dur, color: 'none', countdownSecs: 0 };
          if (isEdit) seqSteps[_seqEditingIdx] = step; else seqSteps.push(step);
          saveSeq(); renderSeqList(); resetSeqMediaInput();
          if (isEdit) exitSeqEditMode();
          showToast(isEdit ? '步驟已修改 ✓' : '影片步驟已加入序列 ✓');
        }).catch(() => showToast('影片儲存失敗：空間不足', 'warn'));
      } else {
        /* 替換舊圖片，只在沒有 preset 引用時才刪舊資料 */
        if (isEdit) {
          const old = seqSteps[_seqEditingIdx];
          if (old && old.content && old.content.startsWith('__img__') && !_mediaInPreset(old.content)) {
            const oldImgId = old.content.slice(7);
            MediaDB.del('img_' + oldImgId);
            localStorage.removeItem('tapmc_img_' + oldImgId);
            FileStore.deleteImage(oldImgId).catch(() => {});
            ServerStore.deleteImage(oldImgId).catch(() => {});
          }
        }
        const _imgDataUrl = _seqPendingMedia.dataUrl;
        /* 1. 伺服器（跨電腦） */
        ServerStore.saveImage(id, _imgDataUrl).catch(() => {});
        /* 2. IndexedDB（本機備援） */
        MediaDB.put('img_' + id, _imgDataUrl).catch(() => {});
        /* 3. 磁碟檔案（FileStore，選用） */
        FileStore.saveImage(id, _imgDataUrl).catch(() => {});
        /* 4. localStorage（備份，空間不足時靜默略過） */
        try { localStorage.setItem('tapmc_img_' + id, _imgDataUrl); } catch {}
        const step = { type: 'image', content: '__img__' + id,
                       size, position: pos, autoDismiss: dur, color: 'none', countdownSecs: 0 };
        if (isEdit) seqSteps[_seqEditingIdx] = step; else seqSteps.push(step);
        saveSeq(); renderSeqList(); resetSeqMediaInput();
        if (isEdit) exitSeqEditMode();
        showToast(isEdit ? '步驟已修改 ✓' : '圖片步驟已加入序列 ✓');
      }
      return;
    }

    /* ── 文字 / 倒數等文字類型 ── */
    const content = document.getElementById('seq-content').value.trim();
    if (!content) { showToast('請輸入內容文字', 'warn'); return; }
    const countdownSecs = type === 'countdown' ? (parseInt(content) || 60) : 0;
    const step = {
      type,
      content:     type === 'countdown' ? String(countdownSecs) : content,
      size,
      color:       seqSelectedColor,
      position:    pos,
      autoDismiss: type === 'countdown' ? countdownSecs : dur,
      countdownSecs,
    };

    if (isEdit) {
      seqSteps[_seqEditingIdx] = step;
      saveSeq(); renderSeqList(); exitSeqEditMode();
      showToast('步驟已修改 ✓');
    } else {
      seqSteps.push(step);
      saveSeq(); renderSeqList();
      document.getElementById('seq-content').value = '';
      showToast('步驟已加入序列 ✓');
    }
  });

  function resetSeqMediaInput() {
    _seqPendingMedia = null;
    const file    = document.getElementById('seq-media-file');
    const label   = document.getElementById('seq-media-label');
    const text    = document.getElementById('seq-media-text');
    const preview = document.getElementById('seq-media-preview');
    if (file)    file.value = '';
    if (text)    text.textContent = '📂 選取媒體檔案';
    if (label)   label.classList.remove('img-upload-btn--loaded');
    if (preview) preview.style.display = 'none';
  }

  /* 開始序列 */
  document.getElementById('btn-seq-start').addEventListener('click', () => {
    if (!seqSteps.length) { showToast('序列尚無步驟', 'warn'); return; }
    const state = { running: true, currentStep: 0, seqId: Date.now() };
    /* ★ 同時把最新步驟資料寫入 localStorage 並夾帶在 BC 訊息裡
       確保背板無論如何都能取得最新序列定義 */
    localStorage.setItem('tapmc_seq',       JSON.stringify({ steps: seqSteps }));
    localStorage.setItem('tapmc_seq_state', JSON.stringify(state));
    if (bc) bc.postMessage({ type: 'seq', state, steps: seqSteps });
    /* 跨電腦：把序列步驟 + 狀態寫到伺服器 */
    ServerStore.isAvailable().then(ok => {
      if (!ok) return;
      Promise.all([
        ServerStore.saveData('tapmc_seq.json',       { steps: seqSteps }),
        ServerStore.saveData('tapmc_seq_state.json', state),
      ]).then(() =>
        ServerStore.saveData('tapmc_version.json', { v: Date.now(), type: 'seq' })
      ).catch(() => {});
    }).catch(() => {});
    renderSeqList();
    showToast('序列已開始 ▶');
  });

  /* 停止序列 */
  document.getElementById('btn-seq-stop').addEventListener('click', () => {
    const state = { running: false, currentStep: -1, seqId: null };
    localStorage.setItem('tapmc_seq_state', JSON.stringify(state));
    if (bc) bc.postMessage({ type: 'seq', state });
    /* 跨電腦：寫停止狀態到伺服器 */
    ServerStore.isAvailable().then(ok => {
      if (!ok) return;
      ServerStore.saveData('tapmc_seq_state.json', state).then(() =>
        ServerStore.saveData('tapmc_version.json', { v: Date.now(), type: 'seq' })
      ).catch(() => {});
    }).catch(() => {});
    renderSeqList();
    showToast('序列已停止 ■');
  });

  /* 清空序列（不刪除 preset 仍在引用的媒體） */
  document.getElementById('btn-seq-clear').addEventListener('click', () => {
    seqSteps.forEach(s => {
      if (s.content && s.content.startsWith('__vid__') && !_mediaInPreset(s.content)) {
        const vid = s.content.slice(7);
        MediaDB.del('vid_' + vid);
        FileStore.deleteVideo(vid).catch(() => {});
        ServerStore.deleteVideo(vid).catch(() => {});
      }
      if (s.content && s.content.startsWith('__img__') && !_mediaInPreset(s.content)) {
        const imgId = s.content.slice(7);
        MediaDB.del('img_' + imgId);
        localStorage.removeItem('tapmc_img_' + imgId);
        FileStore.deleteImage(imgId).catch(() => {});
        ServerStore.deleteImage(imgId).catch(() => {});
      }
    });
    seqSteps = []; saveSeq(); renderSeqList();
    showToast('序列已清空');
  });

  /* ════════════════════════════════════════════════
     媒體保護：判斷某個 content key 是否被已儲存的 preset 引用
     content 格式例：'__img__1234' 或 '__vid__1234'
     ════════════════════════════════════════════════ */
  function _mediaInPreset(contentKey) {
    /* 每次從 localStorage 讀取最新 presets，確保判斷準確 */
    const presets = JSON.parse(localStorage.getItem('tapmc_seq_presets') || '[]');
    return presets.some(p => Array.isArray(p.steps) && p.steps.some(s => s.content === contentKey));
  }

  /* ════════════════════════════════════════════════
     localStorage
     ════════════════════════════════════════════════ */
  function saveElements() {
    try {
      localStorage.setItem('tapmc_elements', JSON.stringify(elements));
    } catch (e) {
      showToast('元素儲存失敗：瀏覽器儲存空間不足', 'warn');
      console.error('[saveElements] 寫入失敗', e);
    }
  }

  function loadElements() {
    try { return JSON.parse(localStorage.getItem('tapmc_elements') || '[]'); }
    catch { return []; }
  }

  /* 監聽跨分頁的 localStorage 變化 */
  window.addEventListener('storage', e => {
    if (e.key === 'tapmc_elements') {
      elements = JSON.parse(e.newValue || '[]');
      renderList();
    }
    if (e.key === 'tapmc_seq_state') {
      renderSeqList();
    }
    /* 其他 admin 分頁修改步驟時，同步本頁的步驟清單 */
    if (e.key === 'tapmc_seq') {
      const d = JSON.parse(e.newValue || 'null');
      if (d && Array.isArray(d.steps)) {
        seqSteps = d.steps;
        renderSeqList();
      }
    }
  });

  /* ════════════════════════════════════════════════
     Toast 提示
     ════════════════════════════════════════════════ */
  let toastTimer = null;
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('toast--show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('toast--show'), 2000);
  }

  /* ── 初始化 ── */
  renderList();
  renderSeqList();

  /* ════════════════════════════════════════════════
     背景主題切換
     ════════════════════════════════════════════════ */
  const THEME_NAMES = {
    dark:  '深邃科技',
    red:   '喜慶紅金',
    warm:  '溫暖橙光',
    white: '品牌白底',
    sunny: '陽光燦爛',
    vivid: '晴空活力',
  };

  function _setActiveThemeBtn(name) {
    document.querySelectorAll('.theme-btn').forEach(b => {
      b.classList.toggle('theme-btn--active', b.dataset.theme === name);
    });
  }

  (function initTheme() {
    const saved = localStorage.getItem('tapmc_theme') || 'dark';
    _setActiveThemeBtn(saved);

    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.theme;
        localStorage.setItem('tapmc_theme', name);
        _setActiveThemeBtn(name);
        notify('theme');
        showToast('主題已切換：' + (THEME_NAMES[name] || name) + ' ✓');
      });
    });
  })();

  /* ════════════════════════════════════════════════
     品牌圖形背景切換
     ════════════════════════════════════════════════ */
  const MOTIF_NAMES = {
    '0':      '關閉',
    'orange': '橙韻流動',
    'drop':   '水滴晶瑩',
    'vivid':  '三色繽紛',
    'geo':    '幾何輔圖',
    'brand':  '品牌特顯',
  };
  function _setActiveMotifBtn(val) {
    document.querySelectorAll('.motif-btn').forEach(b => {
      b.classList.toggle('theme-btn--active', b.dataset.motif === val);
    });
  }
  (function initMotif() {
    const saved = localStorage.getItem('tapmc_motif') || '0';
    _setActiveMotifBtn(saved);
    document.querySelectorAll('.motif-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.motif;
        localStorage.setItem('tapmc_motif', val);
        _setActiveMotifBtn(val);
        notify('motif');
        showToast('品牌圖形：' + (MOTIF_NAMES[val] || val) + ' ✓');
      });
    });
  })();

  /* ════════════════════════════════════════════════
     伺服器模式初始化
     在所有變數與函式定義完成後非同步執行：
     · 若 /api/ping 回應正常 → 伺服器模式
     · 從 data/ 載入最新清單（優先於 localStorage）
     · 更新 dir-bar 顯示狀態
     ════════════════════════════════════════════════ */
  (async function _serverInit() {
    const ok = await ServerStore.isAvailable();
    if (!ok) return;   /* 非伺服器模式，Branch A / B 維持原有邏輯 */

    /* ── 更新 dir-bar 為伺服器模式 ── */
    const ds  = document.getElementById('dir-status');
    const lbl = document.getElementById('dir-bar-label');
    if (ds) {
      ds.textContent = '🌐 伺服器模式，資料自動同步至 data/';
      ds.className   = 'dir-bar__path dir-bar__path--set';
    }
    if (lbl) lbl.textContent = '伺服器儲存（跨電腦共用）';

    /* 隱藏所有手動按鈕（匯出/匯入/選擇目錄） */
    ['btn-pick-dir', 'btn-export-json', 'btn-import-json'].forEach(btnId => {
      const el = document.getElementById(btnId);
      if (el) el.style.display = 'none';
    });

    /* ── 從伺服器載入序列清單（Presets） ── */
    const sPresets = await ServerStore.loadData('tapmc_presets.json');
    if (Array.isArray(sPresets)) {
      seqPresets = sPresets;
      try { localStorage.setItem('tapmc_seq_presets', JSON.stringify(seqPresets)); } catch {}
      renderPresetList();
    }

    /* ── 從伺服器載入目前序列步驟 ── */
    const sSteps = await ServerStore.loadData('tapmc_seq_steps.json');
    if (Array.isArray(sSteps)) {
      seqSteps = sSteps;
      try { localStorage.setItem('tapmc_seq', JSON.stringify({ steps: seqSteps })); } catch {}
      renderSeqList();
    }

    /* ── 從伺服器載入主題 ── */
    const sTheme = await ServerStore.loadData('tapmc_theme.json');
    if (sTheme && sTheme.theme) {
      localStorage.setItem('tapmc_theme', sTheme.theme);
      _setActiveThemeBtn(sTheme.theme);
    }

    showToast('已連線至伺服器，清單同步完成 ✓');
  })();

})();
