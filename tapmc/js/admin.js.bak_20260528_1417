  /* ── 判斷是否為 TIF/TIFF（需要伺服器端轉換） ── */
  function _isTiff(file) {
    const ext  = (file.name.split('.').pop() || '').toLowerCase();
    const mime = (file.type || '').toLowerCase();
    return mime === 'image/tiff' || ext === 'tif' || ext === 'tiff';
  }

  /* ── 伺服器端 TIF → JPEG 轉換（使用 Pillow） ── */
  function _convertTiffViaServer(file, callback) {
    /* 先確認伺服器是否可達，再送 TIF；避免在離線時浪費 2s timeout */
    ServerStore.isAvailable().then(ok => {
      if (!ok) { callback(null); return; }
      /* 與 ServerStore 共用相同的 BASE（已由 TAPMC_API_BASE 或相對路徑決定） */
      const BASE = (typeof window !== 'undefined' && window.TAPMC_API_BASE)
                    ? window.TAPMC_API_BASE : '';
      const form = new FormData();
      form.append('file', file);
      fetch(BASE + '/api/tapmc/convert-image', {
        method: 'POST',
        body: form,
        headers: { 'ngrok-skip-browser-warning': 'tapmc' },
      })
        .then(r => {
          if (!r.ok) return r.json().then(j => { throw new Error(j.detail || r.status); });
          return r.json();
        })
        .then(j => callback(j.dataUrl, j.width, j.height))
        .catch(err => {
          console.error('[convertTiff]', err);
          callback(null);
        });
    });
  }

  /* ── 圖片壓縮（Canvas API → JPEG base64，適用瀏覽器可解碼的格式） ── */
  function compressImage(file, callback) {
    /* TIF/TIFF → 改走伺服器轉換，不進 Canvas */
    if (_isTiff(file)) {
      _convertTiffViaServer(file, callback);
      return;
    }
    const MAX_W = 1920, MAX_H = 1080, QUALITY = 0.85;
    const reader = new FileReader();
    reader.onload = function (re) {
      const original = re.target.result;
      const imgEl    = new Image();
      /* onerror：瀏覽器無法解碼（不支援格式）→ 以 null 回呼 */
      imgEl.onerror = function () { callback(null); };
      imgEl.onload = function () {
        let w = imgEl.width, h = imgEl.height;
        if (w > MAX_W || h > MAX_H) {
          const ratio = Math.min(MAX_W / w, MAX_H / h);
          w = Math.round(w * ratio);
          h = Math.round(h * ratio);
        }
        const canvas = document.createElement('canvas');
        canvas.width  = w;
        canvas.height = h;
        canvas.getContext('2d').drawImage(imgEl, 0, 0, w, h);
        const dataUrl = canvas.toDataURL('image/jpeg', QUALITY);
        callback(dataUrl, w, h, original.length, dataUrl.length);
      };
      imgEl.src = original;
    };
    reader.readAsDataURL(file);
  }

