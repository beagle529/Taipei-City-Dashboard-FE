/**
 * 臺北農產 51 週年背板 ── 後台控制台
 * admin.js  |  版本 3.0
 *
 * 通訊：localStorage（資料） + BroadcastChannel（即時通知）
 */

(function () {
  'use strict';

  /* ════════════════════════════════════════════════
     IndexedDB 媒體儲存（影片 Blob）
     ════════════════════════════════════════════════ */
  const MediaDB = (function () {
    let _db = null;
    function open() {
      if (_db) return Promise.resolve(_db);
      return new Promise((resolve, reject) => {
        const req = indexedDB.open('tapmc_media', 1);
        req.onupgradeneeded = e => e.target.result.createObjectStore('blobs');
        req.onsuccess  = e => { _db = e.target.result; resolve(_db); };
        req.onerror    = reject;
      });
    }
    return {
      put(key, blob) {
        return open().then(db => new Promise((resolve, reject) => {
          const tx = db.transaction('blobs', 'readwrite');
          tx.objectStore('blobs').put(blob, key);
          tx.oncomplete = resolve;
          tx.onerror    = reject;
        }));
      },
      get(key) {
        return open().then(db => new Promise((resolve, reject) => {
          const req = db.transaction('blobs', 'readonly').objectStore('blobs').get(key);
          req.onsuccess = e => resolve(e.target.result);
          req.onerror   = reject;
        }));
      },
      del(key) {
        return open().then(db => new Promise((resolve, reject) => {
          const tx = db.transaction('blobs', 'readwrite');
          tx.objectStore('blobs').delete(key);
          tx.oncomplete = resolve;
          tx.onerror    = reject;
        })).catch(() => {});
      },
    };
  })();

  /* ── BroadcastChannel（與 backdrop.js 同頻道，雙向） ── */
  let bc = null;
  try {
    bc = new BroadcastChannel('tapmc_backdrop');
    /* 接收背板回傳的序列進度，即時更新清單 */
    bc.onmessage = e => {
      if (e.data === 'seq' || (e.data && e.data.type === 'seq')) {
        /* 序列步驟已推進或結束 → 同步序列步驟（若有夾帶）並重繪清單 */
        const incoming = e.data && e.data.steps;
        if (incoming) {
          seqSteps = incoming;
          localStorage.setItem('tapmc_seq', JSON.stringify({ steps: seqSteps }));
        }
        renderSeqList();
      }
      if (e.data === 'tapmc_elements' || e.data === 'elements') {
        elements = loadElements();
        renderList();
      }
      /* 背板上線 → 送出目錄 handle（讓背板可直接讀取媒體檔案） */
      if (e.data && e.data.type === 'ready' && FileStore.hasDirectory()) {
        bc.postMessage({ type: 'fstore_handle', handle: FileStore.getHandle() });
      }
    };
  } catch (_) {}

  function notify(type) {
    if (bc) bc.postMessage(type);
    _serverSync(type);   /* 跨電腦：同步至伺服器 */
  }

  /* 跨電腦通訊：將最新資料寫入伺服器 + 更新版本號
     背板每 1.5 秒輪詢版本號，偵測到變動後自動取回資料 */
  function _serverSync(type) {
    ServerStore.isAvailable().then(ok => {
      if (!ok) return;
      let p = null;
      if (type === 'elements') {
        p = ServerStore.saveData('tapmc_elements.json', elements);
      } else if (type === 'text') {
        const d = JSON.parse(localStorage.getItem('tapmc_text') || 'null');
        if (d) p = ServerStore.saveData('tapmc_text.json', d);
      } else if (type === 'ticker') {
        const d = JSON.parse(localStorage.getItem('tapmc_ticker') || 'null');
        if (d) p = ServerStore.saveData('tapmc_ticker.json', d);
      } else if (type === 'badge') {
        const d = JSON.parse(localStorage.getItem('tapmc_badge') || 'null');
        if (d) p = ServerStore.saveData('tapmc_badge.json', d);
      } else if (type === 'title_anim') {
        p = ServerStore.saveData('tapmc_title_anim.json',
              { v: localStorage.getItem('tapmc_title_anim') || '1' });
      } else if (type === 'theme') {
        const t = localStorage.getItem('tapmc_theme') || 'dark';
        p = ServerStore.saveData('tapmc_theme.json', { theme: t });
      } else if (type === 'motif') {
        p = ServerStore.saveData('tapmc_motif.json',
              { v: localStorage.getItem('tapmc_motif') || '0' });
      }
      /* 資料寫入完成（或不需寫入）→ 更新版本號，讓背板感知到變動 */
      const bump = () => ServerStore.saveData(
        'tapmc_version.json', { v: Date.now(), type }).catch(() => {});
      if (p) p.then(bump).catch(bump);
      else   bump();
    }).catch(() => {});
  }

  /* ════════════════════════════════════════════════
     資料儲存 UI（File System Access API 或 匯出/匯入備用方案）
     ════════════════════════════════════════════════ */

  /* ── 共用：更新狀態列 ── */
  function _updateDirStatus(ok) {
    const el  = document.getElementById('dir-status');
    const lbl = document.getElementById('dir-bar-label');
    if (!el) return;
    if (ok) {
      el.textContent = '📂 ' + FileStore.getDirectoryName();
      el.className   = 'dir-bar__path dir-bar__path--set';
      if (lbl) lbl.textContent = '工作目錄（自動存檔）';
    } else {
      el.textContent = '未設定，點右側「選擇目錄」';
      el.className   = 'dir-bar__path';
      if (lbl) lbl.textContent = '工作目錄（自動存檔）';
    }
  }

  /* ── 共用：把資料下載為 JSON 檔 ── */
  function _downloadJSON(filename, data) {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  /* ── 共用：從 JSON 檔匯入 ── */
  function _importJSONFile(callback) {
    const input  = document.createElement('input');
    input.type   = 'file';
    input.accept = '.json,application/json';
    input.onchange = () => {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try { callback(JSON.parse(reader.result)); }
        catch { showToast('檔案格式錯誤，請選取正確的 JSON 檔', 'warn'); }
      };
      reader.readAsText(file);
    };
    input.click();
  }

  const _fsSupported = FileStore.isSupported();

  /* ── 分支 A：支援 File System Access API（Chrome/Edge）── */
  if (_fsSupported) {
    const btnPick = document.getElementById('btn-pick-dir');
    if (btnPick) btnPick.style.display = '';

    btnPick && btnPick.addEventListener('click', async () => {
      try {
        await FileStore.pickDirectory();
        _updateDirStatus(true);
        FileStore.saveJSON('tapmc_presets.json',   seqPresets).catch(() => {});
        FileStore.saveJSON('tapmc_seq_steps.json', seqSteps).catch(() => {});
        showToast('目錄已設定：' + FileStore.getDirectoryName() + ' ✓');
        if (bc) bc.postMessage({ type: 'fstore_handle', handle: FileStore.getHandle() });
      } catch (e) {
        if (e.name !== 'AbortError') showToast('選擇目錄失敗：' + e.message, 'warn');
      }
    });

    /* 啟動：嘗試還原上次目錄 */
    FileStore.restoreHandle().then(async ok => {
      _updateDirStatus(ok);
      if (!ok) return;
      const fPresets = await FileStore.loadJSON('tapmc_presets.json').catch(() => null);
      if (Array.isArray(fPresets)) {
        seqPresets = fPresets;
        try { localStorage.setItem('tapmc_seq_presets', JSON.stringify(seqPresets)); } catch {}
        renderPresetList();
      }
      const fSteps = await FileStore.loadJSON('tapmc_seq_steps.json').catch(() => null);
      if (Array.isArray(fSteps)) {
        seqSteps = fSteps;
        try { localStorage.setItem('tapmc_seq', JSON.stringify({ steps: seqSteps })); } catch {}
        renderSeqList();
      }
      if (bc) bc.postMessage({ type: 'fstore_handle', handle: FileStore.getHandle() });
    });

  /* ── 分支 B：不支援 API → 顯示 匯出/匯入 按鈕 ── */
  } else {
    /* 更新狀態欄說明 */
    const ds  = document.getElementById('dir-status');
    const lbl = document.getElementById('dir-bar-label');
    if (ds)  { ds.textContent = '資料存於瀏覽器（IndexedDB）'; ds.className = 'dir-bar__path dir-bar__path--set'; }
    if (lbl) lbl.textContent = '本機儲存　·　可匯出備份';

    /* 顯示匯出 / 匯入按鈕 */
    const btnExp = document.getElementById('btn-export-json');
    const btnImp = document.getElementById('btn-import-json');
    if (btnExp) btnExp.style.display = '';
    if (btnImp) btnImp.style.display = '';

    /* 匯出：下載 tapmc_backup.json（含 presets + steps） */
    btnExp && btnExp.addEventListener('click', () => {
      const backup = { presets: seqPresets, steps: seqSteps, exportedAt: new Date().toISOString() };
      _downloadJSON('tapmc_backup.json', backup);
      showToast('已下載 tapmc_backup.json ✓');
    });

    /* 匯入：從 JSON 檔還原 presets + steps */
    btnImp && btnImp.addEventListener('click', () => {
      _importJSONFile(data => {
        let changed = false;
        if (Array.isArray(data.presets)) {
          seqPresets = data.presets;
          try { localStorage.setItem('tapmc_seq_presets', JSON.stringify(seqPresets)); } catch {}
          renderPresetList();
          changed = true;
        }
        if (Array.isArray(data.steps)) {
          seqSteps = data.steps;
          try { localStorage.setItem('tapmc_seq', JSON.stringify({ steps: seqSteps })); } catch {}
          renderSeqList();
          changed = true;
        }
        if (changed) showToast('已匯入備份資料 ✓');
        else showToast('找不到可匯入的資料（格式錯誤）', 'warn');
      });
    });
  }

  /* ── 預設文字 ── */
  const DEFAULTS = {
    title:    '臺北農產',
    year:     '115 年度',
    event:    '股東常會',
    eyebrow:  '2025 · TAPMC',
    footnote: 'Annual General Meeting of Shareholders',
  };

  const TYPE_LABEL = {
    float: '浮動', 'lower-third': '下方條', announce: '公告框',
    countdown: '倒數', vip: '歡迎VIP', image: '圖片', video: '影片',
  };

  /* ── DOM 參照 ── */
  const elList = document.getElementById('el-list');

  /* ── 狀態 ── */
  let elements      = loadElements();
  let selectedColor = 'white';

  /* ════════════════════════════════════════════════
     連線狀態偵測
     優先：伺服器連線（跨裝置）；次要：localStorage（同裝置）
     ════════════════════════════════════════════════ */
  (function checkStatus() {
    const dot  = document.getElementById('status-dot');
    const text = document.getElementById('status-text');

    dot.className = 'status-dot';   /* 清除舊狀態 */

    /* ── 1. 先偵測同裝置（localStorage 心跳） ── */
    const lastSeen = localStorage.getItem('tapmc_backdrop_alive');
    if (lastSeen) {
      const secs = Math.round((Date.now() - parseInt(lastSeen)) / 1000);
      if (secs < 30) {
        dot.classList.add('status-dot--on');
        text.textContent = '背板已連線（同裝置，' + secs + ' 秒前確認）';
        setTimeout(checkStatus, 5000);
        return;
      }
    }

    /* ── 2. 再偵測伺服器（跨裝置） ── */
    ServerStore.isAvailable().then(ok => {
      dot.className = 'status-dot';
      if (ok) {
        dot.classList.add('status-dot--on');
        text.textContent = '✅ 伺服器已連線，指令透過伺服器同步至背板';
      } else {
        dot.classList.add('status-dot--off');
        text.textContent = '未偵測到背板或伺服器，請確認 index.html 已開啟';
      }
    }).catch(() => {
      dot.className = 'status-dot status-dot--off';
      text.textContent = '未偵測到背板或伺服器，請確認 index.html 已開啟';
    });

    setTimeout(checkStatus, 5000);
  })();

  /* ════════════════════════════════════════════════
     分頁切換
     ════════════════════════════════════════════════ */
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('tab--active'));
      document.querySelectorAll('.pane').forEach(p => p.classList.remove('pane--active'));
      tab.classList.add('tab--active');
      document.getElementById('tab-' + tab.dataset.tab).classList.add('pane--active');
    });
  });

  /* ════════════════════════════════════════════════
     Tab：歡迎長官
     ════════════════════════════════════════════════ */
  let roster  = JSON.parse(localStorage.getItem('tapmc_vip_roster')  || '[]');
  let history = JSON.parse(localStorage.getItem('tapmc_vip_history') || '[]');

  function showVip(name) {
    if (!name) { showToast('請輸入姓名職稱', 'warn'); return; }

    const durSecs  = parseInt(document.getElementById('vip-duration').value);
    const vipStyle = document.getElementById('vip-style').value;

    const el = {
      id:           Date.now(),
      type:         vipStyle,
      content:      vipStyle === 'vip' ? name : '歡迎 ' + name + ' 蒞臨',
      size:         vipStyle === 'vip' ? 0 : 36,
      /* lower-third 背景為深色，文字必須用 white，
         gradient 類別會讓文字透明導致看不見          */
      color:        vipStyle === 'vip' ? 'gradient' : 'white',
      position:     'center',
      visible:      true,
      autoDismiss:  durSecs,
      countdownSecs: 0,
      fromVip:      true,   /* 標記來自 VIP 歡迎，供緊急下架使用 */
    };

    elements.push(el);
    saveElements();
    notify('elements');
    renderList();

    history.unshift({ name, time: Date.now(), style: vipStyle, dur: durSecs });
    if (history.length > 50) history.pop();
    localStorage.setItem('tapmc_vip_history', JSON.stringify(history));
    renderHistory();

    showToast('歡迎畫面已送出 ✓');
  }

  document.getElementById('btn-vip').addEventListener('click', () => {
    const name = document.getElementById('vip-name').value.trim();
    showVip(name);
    document.getElementById('vip-name').value = '';
  });

  document.getElementById('vip-name').addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('btn-vip').click();
  });

  /* 名單管理 */
  function renderRoster() {
    const list = document.getElementById('vip-roster-list');
    if (!roster.length) {
      list.innerHTML = '<p class="empty" style="font-size:11px;">點右上角 ✏️ 新增名單</p>';
      return;
    }
    list.innerHTML = '';
    roster.forEach(name => {
      const btn = document.createElement('button');
      btn.className = 'vip-chip';
      btn.innerHTML = `<span class="vip-chip__name">${name}</span><span class="vip-chip__go">▶</span>`;
      btn.addEventListener('click', () => showVip(name));
      list.appendChild(btn);
    });
  }

  const rosterEdit = document.getElementById('vip-roster-edit');
  document.getElementById('btn-toggle-roster-edit').addEventListener('click', () => {
    const isOpen = rosterEdit.style.display !== 'none';
    if (isOpen) {
      rosterEdit.style.display = 'none';
    } else {
      document.getElementById('vip-roster-input').value = roster.join('\n');
      rosterEdit.style.display = 'flex';
    }
  });

  document.getElementById('btn-cancel-roster').addEventListener('click', () => {
    rosterEdit.style.display = 'none';
  });

  document.getElementById('btn-save-roster').addEventListener('click', () => {
    const raw = document.getElementById('vip-roster-input').value;
    roster = raw.split('\n').map(s => s.trim()).filter(Boolean);
    localStorage.setItem('tapmc_vip_roster', JSON.stringify(roster));
    rosterEdit.style.display = 'none';
    renderRoster();
    showToast('名單已儲存 ✓');
  });

  function renderHistory() {
    const list = document.getElementById('vip-history-list');
    if (!history.length) {
      list.innerHTML = '<p class="empty" style="font-size:11px;">尚無紀錄</p>';
      return;
    }
    list.innerHTML = '';
    history.forEach(h => {
      const d    = new Date(h.time);
      const hhmm = d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
      const dur  = h.dur > 0 ? h.dur + '秒' : '不消失';
      const div  = document.createElement('div');
      div.className = 'vip-log-item';
      div.innerHTML = `<span class="vip-log-item__name">${h.name}</span>
                       <span class="vip-log-item__time">${hhmm}　${dur}</span>`;
      list.appendChild(div);
    });
  }

  document.getElementById('btn-clear-history').addEventListener('click', () => {
    history = [];
    localStorage.setItem('tapmc_vip_history', JSON.stringify(history));
    renderHistory();
    showToast('呈現紀錄已清除');
  });

  /* ── 緊急下架：移除目前所有來自 VIP 歡迎的元素 ── */
  document.getElementById('btn-vip-dismiss').addEventListener('click', () => {
    /* 若連續播放中，一併停止 */
    stopVipQueue(false);

    const before = elements.length;
    elements = elements.filter(el => !el.fromVip);
    if (elements.length < before) {
      saveElements();
      notify('elements');
      showToast('歡迎畫面已下架 ✓');
    } else {
      showToast('目前沒有正在顯示的歡迎畫面', 'warn');
    }
  });

  /* ── 連續播放全部名單 ── */
  let _vipQueueTimer = null;
  let _vipQueueIdx   = 0;
  let _vipQueueOn    = false;

  function _updatePlayAllBtn() {
    const btn = document.getElementById('btn-vip-play-all');
    if (!btn) return;
    if (_vipQueueOn) {
      btn.textContent      = '■ 停止連續播放';
      btn.style.background = 'rgba(230,0,92,0.25)';
      btn.style.border     = '1px solid rgba(230,0,92,0.60)';
      btn.style.color      = '#ff6b9d';
    } else {
      btn.textContent      = '▶▶  連續播放全部名單';
      btn.style.background = '';
      btn.style.border     = '';
      btn.style.color      = '';
    }
  }

  function stopVipQueue(showMsg) {
    clearTimeout(_vipQueueTimer);
    _vipQueueTimer = null;
    _vipQueueIdx   = 0;
    _vipQueueOn    = false;
    _updatePlayAllBtn();
    if (showMsg !== false) showToast('已停止連續播放');
  }

  function _playQueueNext() {
    if (_vipQueueIdx >= roster.length) {
      /* 全部播完 */
      stopVipQueue(false);
      showToast('名單播放完畢 ✓');
      return;
    }
    const name    = roster[_vipQueueIdx];
    const durSecs = parseInt(document.getElementById('vip-duration').value) || 10;
    showVip(name);
    _vipQueueIdx++;

    if (_vipQueueIdx < roster.length) {
      /* 等目前這位消失後再顯示下一位（額外加 0.5 秒過渡緩衝） */
      _vipQueueTimer = setTimeout(_playQueueNext, (durSecs + 0.5) * 1000);
    } else {
      /* 最後一位：等它消失後結束 */
      _vipQueueTimer = setTimeout(() => {
        stopVipQueue(false);
        showToast('名單播放完畢 ✓');
      }, (durSecs + 0.5) * 1000);
    }
  }

  document.getElementById('btn-vip-play-all').addEventListener('click', () => {
    if (_vipQueueOn) {
      stopVipQueue();
      return;
    }
    if (!roster.length) {
      showToast('名單是空的，請先編輯名單', 'warn');
      return;
    }
    _vipQueueIdx = 0;
    _vipQueueOn  = true;
    _updatePlayAllBtn();
    showToast('開始連續播放，共 ' + roster.length + ' 位 ▶▶');
    _playQueueNext();
  });

  renderRoster();
  renderHistory();

  /* ════════════════════════════════════════════════
     Tab：文字設定 ── 左上角識別區（Logo + 角標）
     ════════════════════════════════════════════════ */

  /* ── Logo 上傳 ── */
  (function initLogoUpload() {
    /* 還原儲存的 Logo 預覽 */
    const saved = localStorage.getItem('tapmc_logo_src');
    if (saved) document.getElementById('logo-preview').src = saved;

    document.getElementById('logo-file-input').addEventListener('change', function () {
      const file = this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        const dataUrl = e.target.result;

        /* 更新預覽 */
        document.getElementById('logo-preview').src = dataUrl;

        /* 儲存：localStorage（即時） + IndexedDB（備份） */
        try {
          localStorage.setItem('tapmc_logo_src', dataUrl);
        } catch (_) {
          /* localStorage 空間不足（大圖）→ 只存 IndexedDB */
        }
        MediaDB.put('tapmc_logo', file).catch(() => {});

        /* 伺服器備份 */
        ServerStore.isAvailable().then(ok => {
          if (ok) ServerStore.saveImage('logo_custom', dataUrl).catch(() => {});
        }).catch(() => {});

        notify('logo');
        showToast('Logo 已更新並套用至背板 ✓');
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('btn-reset-logo').addEventListener('click', () => {
      localStorage.removeItem('tapmc_logo_src');
      MediaDB.del('tapmc_logo').catch(() => {});
      document.getElementById('logo-preview').src = 'assets/logo-beinong-market.png';
      notify('logo');
      showToast('Logo 已還原為預設 ✓');
    });
  })();

  /* ── 角標（51th）── */
  (function initBadge() {
    const saved = JSON.parse(localStorage.getItem('tapmc_badge') || 'null');
    if (saved) {
      document.getElementById('cfg-badge-num').value = saved.num || '51';
      document.getElementById('cfg-badge-sup').value = saved.sup || 'th';
    }

    document.getElementById('btn-apply-badge').addEventListener('click', () => {
      const data = {
        num: document.getElementById('cfg-badge-num').value.trim() || '51',
        sup: document.getElementById('cfg-badge-sup').value.trim() || 'th',
      };
      localStorage.setItem('tapmc_badge', JSON.stringify(data));
      notify('badge');
