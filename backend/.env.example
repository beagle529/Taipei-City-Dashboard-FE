# Copy this to .env and fill in your values

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$examplehashgoeshere

# JWT settings
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_HOURS=24

# Path to the frontend public/ directory (relative to backend/ or absolute)
PUBLIC_DIR=../public
